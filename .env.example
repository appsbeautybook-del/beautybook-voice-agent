# ─── Serveur vocal IA — variables d'environnement ─────────────────────────────
# Copier vers .env puis renseigner les vraies valeurs. Ne JAMAIS commiter .env.

# Port d'écoute local (Render/Railway injectent PORT automatiquement)
PORT=3000

# URL publique HTTPS du serveur (ex : https://voice-agent.onrender.com)
# Utilisée pour construire les URLs de webhooks Twilio et le flux Media Streams.
PUBLIC_BASE_URL=https://votre-serveur.onrender.com

# ─── Twilio ───────────────────────────────────────────────────────────────────
# Console : https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Deepgram (transcription vocale temps réel, français) ────────────────────
# https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cerveau conversationnel : OpenAI ou xAI (Grok) ───────────────────────────
# Les deux exposent une API compatible OpenAI (function calling inclus).
# LLM_PROVIDER=openai → utilise OPENAI_API_KEY (+ OPENAI_MODEL en option).
# LLM_PROVIDER=xai     → utilise XAI_API_KEY (+ LLM_MODEL en option).
LLM_PROVIDER=openai

# --- Si LLM_PROVIDER=openai ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle de conversation (gpt-4o-mini = bon compromis coût/latence/qualité FR)
OPENAI_MODEL=gpt-4o-mini

# --- Si LLM_PROVIDER=xai (Grok) ---
# https://console.x.ai → API Keys
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle Grok par défaut : grok-4.20-non-reasoning-latest
# (non-reasoning = pas de raisonnement long = faible latence, idéal pour la voix)
# Pour choisir un autre modèle : LLM_MODEL=grok-4.1-fast-non-reasoning
LLM_MODEL=grok-4.20-non-reasoning-latest
# URL de l'API xAI (valeur par défaut, à changer uniquement si besoin)
# LLM_BASE_URL=https://api.x.ai/v1

# ─── ElevenLabs (voix de synthèse, streaming) ────────────────────────────────
# https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (BeautyBook — lecture services/horaires, écriture RDV) ─────────
# Utiliser la clé SERVICE ROLE (settings → API) : le serveur écrit en base
# sans passer par les règles RLS. À garder strictement secrète.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Google OAuth (connexion Agenda par salon) ───────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth client
# Redirect URI à déclarer : ${PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
